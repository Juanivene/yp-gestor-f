# Conexión a Postgres (Neon / Netlify DB). En Netlify se carga en Site configuration > Environment variables.
# Para desarrollo local, copiá este archivo a .env y pegá la URL de tu base.
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require

# Duración de la sesión en horas (renovación deslizante)
SESSION_TTL_HOURS=8

# Contraseña del usuario "admin" que crea el seed
SEED_ADMIN_PASSWORD=admin12345
