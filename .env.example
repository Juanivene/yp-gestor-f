# Conexión a la base. En desarrollo apunta al Postgres de docker-compose.dev.yml.
# En producción (docker compose) la arma el compose a partir de las variables POSTGRES_*.
DATABASE_URL=postgres://ypf:ypf_dev_password@localhost:5432/ypf

# Credenciales del Postgres (las usan db y app en docker-compose.yml)
POSTGRES_USER=ypf
POSTGRES_PASSWORD=ypf_dev_password
POSTGRES_DB=ypf

# Dominio público para Caddy (HTTPS automático). Usá "localhost" para probar en local.
DOMAIN=localhost

# Duración de la sesión en horas (renovación deslizante)
SESSION_TTL_HOURS=8

# Contraseña del usuario "admin" que crea el seed
SEED_ADMIN_PASSWORD=admin12345

# development | production
NODE_ENV=development
